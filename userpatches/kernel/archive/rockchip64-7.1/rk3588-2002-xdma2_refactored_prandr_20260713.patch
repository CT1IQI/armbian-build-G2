+
+/* --- Version Check Macros --- */
+#define LINUX_VERSION_CHECK(major, minor, rev) (LINUX_VERSION_CODE >= KERNEL_VERSION(major, minor, rev))
+
+#ifdef RHEL_RELEASE_CODE
+#define KERNEL_VERSION_CHECK(rhel_major, rhel_minor, linux_major, linux_minor, linux_rev) \
+	(RHEL_RELEASE_CODE >= RHEL_RELEASE_VERSION(rhel_major, rhel_minor))
+#else
+/* Standard Linux definition */
+#define KERNEL_VERSION_CHECK(rhel_major, rhel_minor, linux_major, linux_minor, linux_rev) \
+	LINUX_VERSION_CHECK(linux_major, linux_minor, linux_rev)
+#endif
+
+/* --- Memory & Alignment --- */
+#ifndef VM_RESERVED
+#define VMEM_FLAGS (VM_IO | VM_DONTEXPAND | VM_DONTDUMP)
+#else
+#define VMEM_FLAGS (VM_IO | VM_RESERVED)
+#endif
+
+/* --- Constants & Magics --- */
+#define XDMA_CHANNEL_NUM_MAX 4
+#define XDMA_MAX_CHANNELS    4
+#define XDMA_MAGIC           0xAD4B0000U
+#define MAGIC_DEVICE         0xDDDDDDDDU
+#define MAGIC_ENGINE         0xEEEEEEEEU
+#define MAGIC_CHAR           0xCCCCCCCCU
+#define MAX_USER_IRQ         16
+#define MAX_RESOURCE_SIZE    ((resource_size_t)-1)
+
+/* --- Debug & Assertion Macros --- */
+#define dbg_init(fmt, ...) pr_debug("XDMA_INIT: " fmt, ##__VA_ARGS__)
+#define dbg_fops(fmt, ...) pr_debug("XDMA_FOPS: " fmt, ##__VA_ARGS__)
+#define dbg_sg(fmt, ...)   pr_debug("XDMA_SG: " fmt, ##__VA_ARGS__)
+#define dbg_tfr(fmt, ...)  pr_debug("XDMA_TFR: " fmt, ##__VA_ARGS__)
+#define dbg_irq(fmt, ...)  pr_debug("XDMA_IRQ: " fmt, ##__VA_ARGS__)
+
+#define xdma_debug_assert_ptr(ptr) \
+    if (!ptr) { pr_err("XDMA: NULL pointer\n"); return -EINVAL; }
+#define xdma_debug_assert_msg(cond, msg, ret_val) \
+    if (!(cond)) { pr_err("XDMA: %s\n", msg); return (ret_val); }
+
+static inline int access_assert(void __user *ptr, unsigned long size) {
+    if (!access_ok(ptr, size)) return -EFAULT;
+    return 0;
+}
+
+/* --- Structures --- */
+struct xdma_dev;
+
+struct xdma_user_irq {
+    struct xdma_dev *xdev;
+    u8 user_idx;
+    u8 events_irq;
+    spinlock_t events_lock;
+    wait_queue_head_t events_wq;
+    irq_handler_t handler;
+    void *dev;
+};
+
+struct xdma_desc {
+    u32 control, bytes, src_addr_lo, src_addr_hi, dst_addr_lo, dst_addr_hi, next_lo, next_hi;
+} __packed;
+
+struct xdma_engine {
+    struct xdma_dev *xdev;
+    char name[32];
+    void __iomem *regs, *sgdma_regs;
+    enum dma_data_direction dir;
+    struct dma_pool *desc_pool;
+    struct completion engine_compl;
+    atomic_t busy;
+    u32 irq_bitmask;
+    int msix_irq_line;
+    bool streaming;
+    int channel;
+    unsigned int magic;
+};
+
+struct xdma_dev {
+    struct pci_dev *pdev;
+    void __iomem *bar[6];
+    resource_size_t bar_size[6];
+    struct xdma_engine *engine_h2c;
+    struct xdma_engine *engine_c2h;
+    struct xdma_user_irq user_irq[MAX_USER_IRQ];
+    int h2c_channel_num, c2h_channel_num;
+    int config_bar_idx, user_bar_idx, bypass_bar_idx;
+    int idx;
+    unsigned int magic;
+    bool offline;
+    u64 feature_id;
+};
+
+/* --- State Logic --- */
+static inline void xdma_device_set_offline(struct xdma_dev *xdev, bool set_offline) {
+    smp_store_release(&(xdev->offline), set_offline);
+}
+static inline bool xdma_device_test_offline(struct xdma_dev *xdev) {
+    return smp_load_acquire(&(xdev->offline));
+}
+
+/* --- API Prototypes --- */
+struct xdma_dev *xdma_device_open(const char *mname, struct pci_dev *pdev, int *user_max, int *h2c_cnt, int *c2h_cnt);
+void xdma_device_close(struct pci_dev *pdev, void *dev_hndl);
+void xdma_device_offline(struct pci_dev *pdev, void *dev_hndl);
+void xdma_device_online(struct pci_dev *pdev, void *dev_hndl);
+ssize_t xdma_xfer_submit(struct xdma_engine *engine, u64 ep_addr, struct scatterlist *sgl, unsigned int sg_len, bool write);
+int position_check(resource_size_t max_pos, loff_t pos, loff_t align, size_t length);
+
+#endif /* XDMA_LIB_H */
+

