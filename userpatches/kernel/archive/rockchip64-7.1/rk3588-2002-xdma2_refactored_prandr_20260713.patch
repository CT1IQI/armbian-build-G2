--- a/drivers/dma/xilinx/libxdma.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/dma/xilinx/libxdma.c	
@@ -0,0 +1,169 @@
+/*
+ * This file is part of the Xilinx DMA IP Core driver for Linux
+ *
+ * Copyright (c) 2016-2024,  Xilinx, Inc.
+ * Copyright (c) 
+ * All rights reserved.
+ *
+ * This source code is free software; you can redistribute it and/or modify it
+ * under the terms and conditions of the GNU General Public License,
+ * version 2, as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ * more details.
+ *
+ * The full GNU General Public License is included in this distribution in
+ * the file called "COPYING".
+ */
+
+#include "libxdma.h"
+#include <linux/slab.h>
+
+static irqreturn_t xdma_isr(int irq, void *dev_id) {
+    struct xdma_engine *engine = dev_id;
+    complete(&engine->engine_compl);
+    return IRQ_HANDLED;
+}
+
+static int engine_init(struct xdma_dev *xdev, struct xdma_engine *engine, int offset, int dir, int ch) {
+    engine->xdev = xdev;
+    engine->dir = dir;
+    engine->channel = ch;
+    engine->magic = MAGIC_ENGINE;
+    engine->regs = xdev->bar[xdev->config_bar_idx] + offset;
+    engine->sgdma_regs = engine->regs + 0x4000;
+    init_completion(&engine->engine_compl);
+    atomic_set(&engine->busy, 0);
+
+    snprintf(engine->name, sizeof(engine->name), "xdma_%s%d", (dir == DMA_TO_DEVICE) ? "h2c" : "c2h", ch);
+    engine->desc_pool = dma_pool_create(engine->name, &xdev->pdev->dev, sizeof(struct xdma_desc), 32, 0);
+    if (!engine->desc_pool) return -ENOMEM;
+
+    engine->msix_irq_line = pci_irq_vector(xdev->pdev, ch + (dir == DMA_FROM_DEVICE ? xdev->h2c_channel_num : 0));
+    return request_irq(engine->msix_irq_line, xdma_isr, 0, engine->name, engine);
+}
+
+struct xdma_dev *xdma_device_open(const char *mname, struct pci_dev *pdev, int *user_max, int *h2c_cnt, int *c2h_cnt) {
+    struct xdma_dev *xdev = kzalloc(sizeof(*xdev), GFP_KERNEL);
+    int i;
+    if (!xdev) return NULL;
+
+    xdev->pdev = pdev;
+    xdev->magic = MAGIC_DEVICE;
+    xdev->h2c_channel_num = *h2c_cnt;
+    xdev->c2h_channel_num = *c2h_cnt;
+    xdev->config_bar_idx = 0;
+    xdev->user_bar_idx = 1;
+    xdev->bypass_bar_idx = 2;
+    xdev->idx = pdev->devfn;
+
+    for (i = 0; i < MAX_USER_IRQ; i++) {
+        xdev->user_irq[i].xdev = xdev;
+        xdev->user_irq[i].user_idx = i;
+        spin_lock_init(&xdev->user_irq[i].events_lock);
+        init_waitqueue_head(&xdev->user_irq[i].events_wq);
+    }
+
+    for (i = 0; i < 6; i++) {
+        xdev->bar_size[i] = pci_resource_len(pdev, i);
+        if (xdev->bar_size[i] > 0) xdev->bar[i] = pci_iomap(pdev, i, 0);
+    }
+
+    xdev->engine_h2c = kcalloc(xdev->h2c_channel_num, sizeof(struct xdma_engine), GFP_KERNEL);
+    xdev->engine_c2h = kcalloc(xdev->c2h_channel_num, sizeof(struct xdma_engine), GFP_KERNEL);
+
+    for (i = 0; i < xdev->h2c_channel_num; i++)
+        engine_init(xdev, &xdev->engine_h2c[i], i * 0x100, DMA_TO_DEVICE, i);
+    for (i = 0; i < xdev->c2h_channel_num; i++)
+        engine_init(xdev, &xdev->engine_c2h[i], 0x1000 + (i * 0x100), DMA_FROM_DEVICE, i);
+
+    return xdev;
+}
+
+void xdma_device_close(struct pci_dev *pdev, void *dev_hndl) {
+    struct xdma_dev *xdev = (struct xdma_dev *)dev_hndl;
+    int i;
+    if (!xdev) return;
+
+    for (i = 0; i < xdev->h2c_channel_num; i++) {
+        free_irq(xdev->engine_h2c[i].msix_irq_line, &xdev->engine_h2c[i]);
+        dma_pool_destroy(xdev->engine_h2c[i].desc_pool);
+    }
+    for (i = 0; i < xdev->c2h_channel_num; i++) {
+        free_irq(xdev->engine_c2h[i].msix_irq_line, &xdev->engine_c2h[i]);
+        dma_pool_destroy(xdev->engine_c2h[i].desc_pool);
+    }
+    kfree(xdev->engine_h2c);
+    kfree(xdev->engine_c2h);
+    for (i = 0; i < 6; i++) if (xdev->bar[i]) pci_iounmap(pdev, xdev->bar[i]);
+    kfree(xdev);
+}
+
+void xdma_device_offline(struct pci_dev *pdev, void *hndl) { xdma_device_set_offline(hndl, true); }
+void xdma_device_online(struct pci_dev *pdev, void *hndl) { xdma_device_set_offline(hndl, false); }
+
+/* implementation of common sanity checks for file offset (position) */
+int position_check(resource_size_t max_pos, loff_t pos, loff_t align, size_t length)
+{
+	if (unlikely(pos < 0)) {	
+		pr_err("Negative address %lld\n", pos);
+		return -EINVAL;
+	}
+	if (unlikely((resource_size_t)pos + length > max_pos)) {
+		pr_err("Attempted access to address range that exceeds size %llu\n", max_pos);
+		return -EFBIG;
+	}
+	if (unlikely(pos & (align - 1))) {	
+		pr_crit("Address 0x%llx is not aligned to %lld bytes\n", pos, align); 
+		return -EPROTO;
+	}
+	return 0;
+}
+
+ssize_t xdma_xfer_submit(struct xdma_engine *engine, u64 ep_addr, struct scatterlist *sgl, unsigned int sg_len, bool write) {
+    struct xdma_desc *desc;
+    dma_addr_t dma;
+    struct scatterlist *sg;
+    int i;
+    ssize_t total = 0;
+
+    if (atomic_xchg(&engine->busy, 1)) return -EBUSY;
+    reinit_completion(&engine->engine_compl);
+
+    for_each_sg(sgl, sg, sg_len, i) {
+        desc = dma_pool_zalloc(engine->desc_pool, GFP_ATOMIC, &dma);
+        if (!desc) { total = -ENOMEM; break; }
+        desc->control = cpu_to_le32(XDMA_MAGIC | (1 << 1));
+        desc->bytes = cpu_to_le32(sg_dma_len(sg));
+        if (write) {
+            desc->src_addr_lo = cpu_to_le32(lower_32_bits(sg_dma_address(sg)));
+            desc->src_addr_hi = cpu_to_le32(upper_32_bits(sg_dma_address(sg)));
+            desc->dst_addr_lo = cpu_to_le32(lower_32_bits(ep_addr));
+            desc->dst_addr_hi = cpu_to_le32(upper_32_bits(ep_addr));
+        } else {
+            desc->src_addr_lo = cpu_to_le32(lower_32_bits(ep_addr));
+            desc->src_addr_hi = cpu_to_le32(upper_32_bits(ep_addr));
+            desc->dst_addr_lo = cpu_to_le32(lower_32_bits(sg_dma_address(sg)));
+            desc->dst_addr_hi = cpu_to_le32(upper_32_bits(sg_dma_address(sg)));
+        }
+        iowrite32(lower_32_bits(dma), engine->sgdma_regs + 0x80);
+        iowrite32(upper_32_bits(dma), engine->sgdma_regs + 0x84);
+        iowrite32(0x1, engine->regs + 0x04);
+        if (!wait_for_completion_timeout(&engine->engine_compl, msecs_to_jiffies(5000))) {
+            dma_pool_free(engine->desc_pool, desc, dma);
+            total = -ETIMEDOUT;
+            break;
+        }
+        dma_pool_free(engine->desc_pool, desc, dma);
+        total += sg_dma_len(sg);
+        ep_addr += sg_dma_len(sg);
+    }
+    atomic_set(&engine->busy, 0);
+    return total;
+}
+
+
+
+

