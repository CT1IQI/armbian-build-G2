+ * the file called "COPYING".
+ */
+
+#include <linux/module.h>
+#include <linux/pci.h>
+#include "libxdma.h"
+
+static int xdma_probe(struct pci_dev *pdev, const struct pci_device_id *id) {
+    struct xdma_dev *xdev;
+    int h2c = 1, c2h = 1, user = 16;
+    int rv;
+
+    rv = pci_enable_device(pdev);
+    if (rv) return rv;
+
+    pci_set_master(pdev);
+    rv = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(64));
+    if (rv) goto err_disable;
+
+    rv = pci_request_regions(pdev, "xdma");
+    if (rv) goto err_disable;
+
+    pci_alloc_irq_vectors(pdev, 1, 32, PCI_IRQ_ALL_TYPES);
+
+    xdev = xdma_device_open("xdma", pdev, &user, &h2c, &c2h);
+    if (!xdev) {
+        rv = -ENOMEM;
+        goto err_regions;
+    }
+
+    pci_set_drvdata(pdev, xdev);
+    return 0;
+
+err_regions:
+    pci_release_regions(pdev);
+err_disable:
+    pci_disable_device(pdev);
+    return rv;
+}
+
+static void xdma_remove(struct pci_dev *pdev) {
+    struct xdma_dev *xdev = pci_get_drvdata(pdev);
+    xdma_device_close(pdev, xdev);
+    pci_free_irq_vectors(pdev);
+    pci_release_regions(pdev);
+    pci_disable_device(pdev);
+}
+
+static const struct pci_device_id ids[] = { { PCI_DEVICE(0x10EE, 0x7024) }, { 0 } };
+MODULE_DEVICE_TABLE(pci, ids);
+static struct pci_driver drv = { .name = "xdma", .id_table = ids, .probe = xdma_probe, .remove = xdma_remove };
+module_pci_driver(drv);
